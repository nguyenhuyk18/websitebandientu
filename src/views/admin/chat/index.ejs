    <div class="container-fluid">

      <!-- Page Heading -->
      <h1 class="h3 mb-2 text-gray-800">Nhắn Tin Với Khách Hàng</h1>


      <!-- DataTales Example -->
      <div class="chatapp-admin-wrapper">
        <!-- Aside: Danh sách khách hàng -->
        <aside class="chatapp-aside">
          <div class="aside-title">Khách hàng</div>
          <ul class="aside-user-list">

            <% for(conver of conversation) { console.log(conver.is_read_admin) %>
            <li class="aside-user" idclient="<%= conver.customer_id %>" onclick="selectChatUser(this , '<%= conver.customer_id %>' , '<%= conver.customer_username  %>')">
              <div class="name"><%= conver.customer_username %></div>
              <div class="last-message"><%= conver.lastMessage %></div>
              <% if(conver.is_read_admin == 2) { %>
              <span class="badge" style="color: #f59e42">.</span>
              <% } %>
              <% if(conver.is_read_admin == 1) { %>
              <span class="badge" style="display: none;">.</span>
              <% } %>
            </li>
            <% } %>
            <!-- ... render động các khách hàng khác ... -->
          </ul>
        </aside>
        <!-- Main chat -->
        <div class="chatapp">
          <div class="title">
            <span class="titlechat" id="chat-customer-name">Hỗ Trợ Viên</span>
            <span class="xTicks" onclick="toggleCloseChat()"><i class="fa fa-times"></i></span>
